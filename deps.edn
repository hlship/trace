{:deps {org.clojure/clojure    {:mvn/version "1.12.5"}
        org.clj-commons/pretty {:mvn/version "3.8.0"}
        mvxcvi/puget           {:mvn/version "1.3.4"}
        criterium/criterium    {:mvn/version "0.4.6"}}
 :aliases
 {;; clj -X:test
  :test
  {:extra-paths ["test"
                 "test-resources"]
   :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                       :git/sha "dfb30dd"}
                 io.github.tonsky/clj-reload          {:mvn/version "1.0.0"}}
   :exec-fn     cognitect.test-runner.api/test}

  :nrepl
  {:extra-deps  {nrepl/nrepl {:mvn/version "1.7.0"}}
   :extra-paths ["test-resources"]
   :main-opts   ["-m" "nrepl.cmdline"]}

  ; clj -T:build
  :build
  {:deps       {io.github.hlship/build-tools {:git/tag "0.10.2" :git/sha "3c446e4"}}
   :ns-default build}}

 :net.lewisship.build/scm
 {:url     "https://github.com/hlship/trace"
  :license :asl}

 :codox/config
 {:description "Utility to assist with REPL-oriented debugging"
  :source-uri  "https://github.com/hlship/trace/blob/master/{filepath}#L{line}"}}
